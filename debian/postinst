#!/bin/sh
# postinst script for debs2sql
set -e

case "$1" in
    configure)
        if [ -r /etc/debs2sql/.env ]; then
            echo "debs2sql: applying database migrations via debs2sql-phinx"
            if ! debs2sql-phinx; then
                echo "debs2sql: WARNING: debs2sql-phinx failed - edit /etc/debs2sql/.env and run debs2sql-phinx manually" >&2
            fi
        else
            echo "edit /etc/debs2sql/.env and run debs2sql-phinx to prepare database";
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
